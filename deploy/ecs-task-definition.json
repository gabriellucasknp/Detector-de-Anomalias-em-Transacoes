{
    "family": "anomaly-detector-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "2048",
    "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
    "containerDefinitions": [
        {
            "name": "anomaly-detector-app",
            "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/anomaly-detector:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 8000,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "APP_ENV",
                    "value": "production"
                },
                {
                    "name": "LOG_LEVEL",
                    "value": "INFO"
                },
                {
                    "name": "SPARK_MASTER",
                    "value": "local[*]"
                }
            ],
            "secrets": [
                {
                    "name": "DB_HOST",
                    "valueFrom": "arn:aws:ssm:us-east-1:ACCOUNT_ID:parameter/anomaly-detector/db_host"
                },
                {
                    "name": "DB_PORT",
                    "valueFrom": "arn:aws:ssm:us-east-1:ACCOUNT_ID:parameter/anomaly-detector/db_port"
                },
                {
                    "name": "DB_USER",
                    "valueFrom": "arn:aws:ssm:us-east-1:ACCOUNT_ID:parameter/anomaly-detector/db_user"
                },
                {
                    "name": "DB_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:anomaly-detector/db_password"
                },
                {
                    "name": "DB_NAME",
                    "valueFrom": "arn:aws:ssm:us-east-1:ACCOUNT_ID:parameter/anomaly-detector/db_name"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/anomaly-detector",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs",
                    "awslogs-create-group": "true"
                }
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "curl -f http://localhost:8000/health || exit 1"
                ],
                "interval": 30,
                "timeout": 10,
                "retries": 3,
                "startPeriod": 60
            }
        }
    ]
}